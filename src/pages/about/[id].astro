---
import Base from '../../layouts/Base.astro';
import {policies} from '../../data/policies';
export function getStaticPaths(){return policies.map(policy=>({params:{id:policy.id},props:{policy}}));}
const {policy}=Astro.props;
---
<Base title={policy.title} description={policy.description}><article class="story-page wrap prose"><a class="breadcrumb" href="/about/">← About YCG</a><span class="eyebrow">CLEAR ABOUT OUR RESPONSIBILITIES</span><h1>{policy.title}</h1><p class="intro">{policy.description}</p>{policy.sections.map(section=><section><h2>{section.heading}</h2><p>{section.body}</p></section>)}{policy.id==='contact'&&<section><h2>Email YCG</h2><p><a href="mailto:okochamary006@gmail.com">okochamary006@gmail.com</a></p><p class="small muted">Opens your email application. Please do not send sensitive personal documents.</p></section>}<a class="button navy" href="/resources/">Find a source or organization →</a></article></Base>
