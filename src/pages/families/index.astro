---
import Base from '../../layouts/Base.astro';
import { familyTopics, familyPathways } from '../../data/family-content';
import { resources } from '../../data/resources';
---
<Base title="Parents & Families" description="Clear starting points for pregnancy, young parenting, childcare, learning and family support, with deeper Toronto and Ontario coverage.">
  <section class="page-heading wrap"><a class="breadcrumb" href="/topics/">← Life in Canada</a><span class="eyebrow">A NEW CHAPTER FOR YOUR FAMILY</span><h1>You’re building a life.<br/>And raising one, too.</h1><p class="intro">Find a starting point for the questions that come with pregnancy, parenting and family life in a new place.</p><p class="coverage-note">Our detailed family coverage currently centres on Toronto, the GTA and Ontario. National information is labelled separately.</p></section>
  <section class="wrap"><h2>Start with your situation</h2><div class="family-path-grid">{familyPathways.map(path=><a class="family-path-card" href={'/families/'+path.id+'/'}><span class="eyebrow">GUIDED PATHWAY</span><h3>{path.title}</h3><p>{path.description}</p><span class="text-link">Choose your next step →</span></a>)}</div></section>
  <section class="section wrap"><div class="section-heading"><div><span class="eyebrow">ONE QUESTION AT A TIME</span><h2>What does your family need?</h2></div><a class="text-link" href="/resources/?category=family">Filter resources by need, audience &amp; location →</a></div><p>Open a topic for a practical next step, a question to ask and a few places to begin. Program pages show eligibility and source-check dates.</p><nav class="pills family-topic-nav" aria-label="Family topics">{familyTopics.map(topic=><a href={'#'+topic.id}>{topic.title}</a>)}</nav>
    <div class="family-topics">{familyTopics.map(topic=><details id={topic.id}><summary>{topic.title}</summary><div class="family-topic-body"><p>{topic.explanation}</p><h3>A useful next step</h3><p>{topic.next}</p><p class="ask-prompt"><strong>A question to ask:</strong> “{topic.ask}”</p><ul class="family-resource-links">{topic.resources.map(id=>{const resource=resources.find(item=>item.id===id)!;return <li><a href={'/resources/'+id+'/'}>{resource.title} →</a><small>{resource.location.label}</small></li>;})}</ul></div></details>)}</div>
  </section>
  <section class="wrap family-feature"><div><span class="eyebrow">A PLACE TO BELONG</span><h2>Find support that fits your family.</h2><p>Explore French-language, Indigenous and culturally responsive programs, support for fathers, disability resources and help with safety. Each serves a particular community or need.</p></div><div class="pills"><a href="/resources/?audience=father">Fathers →</a><a href="/resources/?audience=francophone">Francophone families →</a><a href="/resources/?audience=indigenous">Indigenous families →</a><a href="/resources/?audience=black">Black communities →</a><a href="/resources/?need=disability">Disability support →</a><a href="/resources/?need=safety">Safety support →</a></div></section>
  <section class="wrap section prose"><h2>A little preparation can make the first call easier.</h2><p>You can say: “I’m looking for help with ____. I live in ____. Can you tell me whether this program fits, what it costs and how to start?” You do not need to share personal documents with YCG.</p><p>These pathways help you navigate services. Healthcare, legal and benefit decisions belong with the relevant professional or responsible organization.</p><a href="/about/trust/">How we check and explain sources →</a></section>
</Base>
<script>
  const revealTopic=()=>{let id=location.hash.slice(1);try{id=decodeURIComponent(id);}catch{return;}const target=document.getElementById(id);if(target instanceof HTMLDetailsElement)target.open=true;};
  window.addEventListener('hashchange',revealTopic);revealTopic();
</script>
