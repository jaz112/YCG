---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import JourneyFinder from '../components/JourneyFinder.astro';
import ResourceCard from '../components/ResourceCard.astro';
import { categories, checklists, provinces } from '../data/catalog';
import { resources } from '../data/resources';
const featured = ['newcomer-services','sin','benefits'].map(id=>resources.find(resource=>resource.id===id)!);
---
<Base title="Your next chapter starts here" description="Understand what to do, where to go, and who can help. Independent guidance and source-backed resources for newcomers to Canada.">
  <section class="hero wrap">
    <div class="hero-copy"><span class="eyebrow"><span class="tiny-spark" aria-hidden="true">✳</span> NEW COUNTRY. NEW POSSIBILITIES.</span><h1>New to Canada?<br/>You don't have to<br/>figure it out <em>alone.</em></h1><p>Your Canada Guide helps you understand what to do, where to go, and who can help—one clear step at a time.</p><div class="hero-actions"><a class="button" href="/start/">Find your next step <Icon name="arrow" size={19}/></a><a class="secondary-link" href="/resources/">Explore newcomer resources ↗</a></div><div class="hero-assurance"><Icon name="shield" size={17}/><span>Independent guidance</span><span aria-hidden="true">·</span><span>Official sources, clearly explained</span></div></div>
    <div class="hero-art"><img src="/images/new-chapter.webp" srcset="/images/new-chapter-480.webp 480w, /images/new-chapter-800.webp 800w, /images/new-chapter.webp 1200w" sizes="(max-width: 560px) calc(100vw - 40px), (max-width: 1280px) 45vw, 560px" alt="Illustration of newcomers finding their way together in a Canadian neighbourhood" width="1200" height="800" fetchpriority="high"/><div class="welcome-note glass"><span class="note-icon"><Icon name="compass" size={25}/></span><div><strong>A little guidance.<br/>A world of possibility.</strong><span>Let's take the next step together.</span></div></div><span class="art-caption">Every beginning belongs here.</span></div>
  </section>
  <section class="discovery wrap" aria-labelledby="discovery-title"><div class="discovery-top"><h2 id="discovery-title">What do you need help with today?</h2><form class="search-form" action="/resources/"><label class="sr-only" for="home-search">What do you need help with?</label><Icon name="search" size={21}/><input id="home-search" name="q" type="search" placeholder="What do you need help with?"/><button type="submit" aria-label="Search resources"><Icon name="arrow" size={21}/></button></form></div><div class="topic-grid">{categories.map((category,index)=><a class={'topic-tile tone-'+index%4} href={category.id==='family'?'/families/':'/topics/'+category.id+'/'}><span class="topic-icon"><Icon name={category.icon}/></span><span>{category.question}</span><span class="topic-arrow" aria-hidden="true">↗</span></a>)}</div><div class="discovery-bottom"><a href="/journeys/?journey=preparing">Arriving soon? Plan ahead →</a><a href="/start/">Not sure where to start? We'll help →</a></div></section>
  <section class="first-days section wrap"><div class="section-heading"><div><span class="eyebrow">SMALL STEPS. A STRONGER START.</span><h2>Your first days, made clearer.</h2></div><a class="text-link" href="/start/#first-days">See the checklists <Icon name="arrow" size={18}/></a></div><div class="timeline">{checklists.map((list,index)=><a class="timeline-item" href={'/start/'+list.id+'/'}><span class="timeline-number">0{index+1}</span><h3>{list.title.replace('Your ','')}</h3><p>{list.description}</p><span class="text-link">See your steps <span aria-hidden="true">→</span></span></a>)}</div><p class="small muted">A suggested pace, not official deadlines. Your circumstances come first.</p></section>
  <section class="section wrap"><div class="family-feature"><div><span class="eyebrow">SUPPORT FOR YOUR FAMILY, TOO</span><h2>Parenting in a new place.</h2><p>Pregnant, raising a baby, finding childcare or returning to school? Start with one need, then find people and programs that may help.</p><p class="small">Detailed local pathways currently focus on Toronto and Ontario.</p></div><div class="pills"><a href="/families/">Parents &amp; Families →</a><a href="/families/pregnant-new-parents/">Pregnant &amp; New Parents →</a><a href="/families/young-parents/">Young Moms &amp; Young Parents →</a></div></div></section>
  <div class="wrap"><JourneyFinder/></div>
  <section class="section wrap"><div class="section-heading"><div><span class="eyebrow">GOOD PLACES TO BEGIN</span><h2>Official information. Real next steps.</h2></div><a class="text-link" href="/resources/?type=government">All government resources <Icon name="arrow" size={18}/></a></div><div class="resource-grid">{featured.map(resource=><ResourceCard resource={resource}/>)}</div></section>
  <section class="local-section"><div class="wrap local-grid"><div><span class="eyebrow">SUPPORT CLOSER TO HOME</span><h2>You don't have to<br/>navigate this <em>by yourself.</em></h2><p>Find organizations and official information relevant to where you live. Start with your province or territory.</p><form class="location-form" action="/resources/"><label class="sr-only" for="local-province">Choose your province or territory</label><select id="local-province" name="province"><option value="">Choose your province or territory</option>{provinces.map(province=><option>{province}</option>)}</select><button class="button" type="submit">Find resources <Icon name="arrow" size={18}/></button></form><p class="small">A growing selection, with deeper Ontario coverage. National information remains available for every province.</p></div><div class="local-organizations"><h3>Community starting points</h3>{['211-canada','build-community','newcomer-services'].map(id=>{const resource=resources.find(item=>item.id===id)!;return <a href={'/resources/'+id+'/'}><span class="org-monogram">{id==='211-canada'?'211':id==='build-community'?'YCG':'CA'}</span><span><strong>{resource.title}</strong><small>{resource.location.label}</small></span><span aria-hidden="true">↗</span></a>;})}<p class="small">Independent listings, not YCG partners. Check program eligibility.</p></div></div></section>
  <section class="section wrap"><div class="safety-banner"><span class="safety-icon"><Icon name="shield" size={36}/></span><div><span class="eyebrow">INFORMATION IS ALSO PROTECTION</span><h2>Something doesn't feel right?</h2><p>Find a route to crisis support, safety planning or help checking suspicious requests.</p></div><a class="button navy" href="/topics/safety/">Find safety & support <Icon name="arrow" size={18}/></a></div></section>
  <section class="founder-section wrap"><div class="founder-quote"><span class="eyebrow">THE REASON YCG EXISTS</span><blockquote>“You should not have to know the right person to find out where to start.”</blockquote><span class="quote-credit">The belief behind Your Canada Guide</span></div><div class="founder-copy"><span class="badge coral">Built from lived experience</span><h2>A personal beginning.<br/>A shared purpose.</h2><p>Mary C. Nwosu, a mother of two with an IT background, arrived in Canada while pregnant. Her curiosity and determination to understand unfamiliar systems inspired YCG—and her wish to share what she learned.</p><a class="text-link" href="/our-story/">Read the founder's story <Icon name="arrow" size={18}/></a></div></section>
  <section class="trust-strip wrap"><div><Icon name="document"/><h3>See the source</h3><p>Understand who publishes the information.</p></div><div><Icon name="compass"/><h3>Know what applies</h3><p>Location and eligibility stay visible.</p></div><div><Icon name="shield"/><h3>Understand the limits</h3><p>Source checks are dated. Uncertainty is stated.</p></div><a class="text-link" href="/about/trust/">How we handle information →</a></section>
</Base>
