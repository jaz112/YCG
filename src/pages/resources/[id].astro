---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { resources, organizationFor } from '../../data/resources';
import { needs, audiences } from '../../data/discovery';
import { categories } from '../../data/catalog';
export function getStaticPaths(){return resources.map(resource=>({params:{id:resource.id},props:{resource}}));}
const { resource }=Astro.props;
const organization=organizationFor(resource);
const review=resource.source.review;
const hasIntake=Boolean(resource.service.ageCriteria || resource.service.immigrationStatus || resource.service.referral || resource.service.appointment || resource.service.delivery==='Contact provider');
const contact={phone:organization.phone,email:organization.email,address:organization.address,...resource.contact};
---
<Base title={resource.title} description={resource.description}>
  <article class="wrap detail-page"><a class="breadcrumb" href="/resources/">← Resource directory</a><div class="detail-grid"><div><span class="badge blue">{organization.type==='government'?'Official government source':organization.type==='public-agency'?'Public agency':organization.type==='public-library'?'Public library':'Community organization'}</span><h1>{resource.title}</h1><p class="intro">{resource.description}</p><p class="organization-name">Published by {organization.name}</p><div class="metadata"><span><Icon name="pin" size={17}/>{resource.location.label}</span><span>YCG explanation</span></div>
    <section class="prose"><h2>How can this help me?</h2><p>{resource.nextStep}</p><h2>Who is it for?</h2><p>{resource.service.audience}</p><div class="notice"><strong>Check who is eligible</strong><p>{resource.service.eligibility.summary}</p><p>Decisions and current requirements come from {resource.service.eligibility.decisionBy}.</p></div>{hasIntake&&<details class="intake-details"><summary>Planning your first contact</summary><dl class="service-details"><dt>Age criteria</dt><dd>{resource.service.ageCriteria??'Not specified in this listing. Confirm for your chosen program.'}</dd><dt>Immigration status</dt><dd>{resource.service.immigrationStatus??'No verified status rule recorded here. Ask the provider; absence of a rule in this listing does not mean unrestricted access.'}</dd><dt>Referral</dt><dd>{resource.service.referral??'Not confirmed. Ask whether you can contact the service directly.'}</dd><dt>Appointment</dt><dd>{resource.service.appointment??'Not confirmed. Check before visiting.'}</dd></dl></details>}{Boolean(resource.service.services?.length)&&<><h2>Services</h2><ul>{resource.service.services!.map(service=><li>{service}</li>)}</ul></>}{resource.beforeOpening!==resource.service.eligibility.summary&&<><h2>Before you open the resource</h2><p>{resource.beforeOpening}</p></>}<h2>Your next step</h2><p>Read the source page, then contact the responsible organization if you need help understanding whether its service applies to you.</p><a class="button" href={resource.source.url}>Visit {organization.name} <span aria-hidden="true">↗</span></a><p class="small muted">External website. Opens in this tab; use Back to return to YCG.</p></section>
  </div><aside class="profile-panel"><h2>At a glance</h2><dl><dt>Organization</dt><dd>{organization.name}</dd><dt>Resource format</dt><dd>{resource.service.delivery}</dd><dt>Cost</dt><dd>{resource.service.cost}. Check fees for any linked program.</dd>{hasIntake&&<><dt>Languages of service</dt><dd>{resource.service.languages.length?resource.service.languages.join(', '):'Not confirmed in this listing. Ask the provider.'}</dd><dt>Delivery options</dt><dd>{resource.service.deliveryMethods?.length?resource.service.deliveryMethods.join(', '):'Confirm the available format with the provider.'}</dd></>}<dt>Service area</dt><dd>{resource.location.serviceArea??resource.location.label}</dd>{Boolean(resource.location.neighbourhoods?.length)&&<><dt>Neighbourhood</dt><dd>{resource.location.neighbourhoods!.join(', ')}</dd></>}<dt>Phone</dt><dd>{contact.phone?<a href={'tel:'+contact.phone.split('ext.')[0].replace(/[^+0-9]/g,'')}>{contact.phone}</a>:'Use the official contact page.'}</dd>{contact.email&&<><dt>Email</dt><dd><a href={'mailto:'+contact.email}>{contact.email}</a></dd></>}<>{contact.address&&<><dt>Address</dt><dd>{contact.address}</dd></>}</><dt>Source page checked</dt><dd>{review.checkedAt??'Not yet checked'}</dd><dt>Source last updated</dt><dd>{review.sourceUpdatedAt??'Not recorded'}</dd><dt>Next review target</dt><dd>{review.nextReviewAt??'Not scheduled'}</dd></dl><h3>Official sources</h3><ul><li><a href={resource.source.url}>Main program or information page ↗</a></li>{resource.supportingSources?.map(source=><li><a href={source.url}>{source.label} ↗</a></li>)}</ul><a href="/about/trust/">What a source check means →</a><p class="small muted">This initial summary was checked against the linked page with AI assistance. It is not an independent audit or a provider endorsement.</p></aside></div>
    <section class="related-topics"><h2>Explore related support</h2><div class="pills">{resource.service.needs?.map(id=><a href={'/resources/?need='+id}>{needs.find(need=>need.id===id)?.label}</a>)}{resource.service.audiences?.map(id=><a href={'/resources/?audience='+id}>{audiences.find(audience=>audience.id===id)?.label}</a>)}</div><h2>Related topics</h2><div class="pills">{resource.service.categories.map(id=><a href={'/topics/'+id+'/'}>{categories.find(category=>category.id===id)?.title}</a>)}</div></section>
  </article>
</Base>
