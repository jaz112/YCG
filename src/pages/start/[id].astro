---
import Base from '../../layouts/Base.astro';
import Checklist from '../../components/Checklist.astro';
import {checklists} from '../../data/catalog';
export function getStaticPaths(){return checklists.map(list=>({params:{id:list.id},props:{list}}));}
const {list}=Astro.props;
---
<Base title={list.title} description={list.description}><div class="wrap checklist-page"><a class="breadcrumb" href="/start/#first-days">← Your first days</a><span class="eyebrow">AT YOUR OWN PACE</span><h1>{list.title}</h1><p class="intro">{list.description}</p><p class="notice">These are suggested planning tasks, not official deadlines. Skip anything that does not apply to you and check program requirements at the linked source.</p><Checklist id={list.id} title="Your next few steps" tasks={list.tasks}/><div class="pills">{checklists.filter(item=>item.id!==list.id).map(item=><a href={'/start/'+item.id+'/'}>{item.title} →</a>)}</div></div></Base>
