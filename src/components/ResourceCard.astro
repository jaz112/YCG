---
import type { Resource } from '../lib/models';
import { organizationFor } from '../data/resources';
import Icon from './Icon.astro';
interface Props { resource: Resource }
const { resource } = Astro.props;
const organization = organizationFor(resource);
const label = organization.type === 'government' ? 'Government source' : organization.type === 'public-agency' ? 'Public agency' : organization.type === 'public-library' ? 'Public library' : 'Community organization';
---
<article class="resource-card">
  <div class="resource-top"><span class:list={['badge',organization.type==='government' ? 'blue' : 'amber']}><Icon name={organization.type==='government'?'shield':'people'} size={15}/>{label}</span><span class="external-mark" aria-hidden="true">↗</span></div>
  <p class="organization-name">{organization.name}</p><h3><a href={`/resources/${resource.id}/`}>{resource.title}</a></h3><p>{resource.description}</p>
  <div class="resource-location"><Icon name="pin" size={16}/>{resource.location.label}</div>
  <div class="card-bottom"><a class="text-link" href={`/resources/${resource.id}/`}>Details & eligibility <span aria-hidden="true">→</span></a><small>Source checked {resource.source.review.checkedAt ?? 'Not yet checked'}</small></div>
</article>
