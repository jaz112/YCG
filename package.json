{
  "name": "your-canada-guide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "lint": "astro check",
    "check:links": "node scripts/check-built-links.mjs",
    "verify": "npm run check && npm test && npm run build && npm run check:links"
  },
  "dependencies": {
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
